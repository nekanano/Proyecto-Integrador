<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="781.0" prefWidth="477.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controlador.RecuperarContrasenaController">
   <children>
      <Pane layoutX="-3.0" prefHeight="257.0" prefWidth="507.0" style="-fx-background-color: #FFFFFF;">
         <children>
            <Label alignment="CENTER" contentDisplay="CENTER" layoutX="91.0" layoutY="153.0" prefHeight="42.0" prefWidth="326.0" text="¿Olvidaste tu contraseña?" textFill="#2C3E50">
               <font>
                  <Font name="Poppins Bold" size="24.0" />
               </font>
            </Label>
            <Label alignment="CENTER" layoutX="33.0" layoutY="202.0" prefHeight="55.0" prefWidth="442.0" text="Ingresa tu correo electrónico y te enviaremos un enlace para restablecer tu contraseña." textAlignment="CENTER" textFill="#555555" wrapText="true">
               <font>
                  <Font name="Poppins Regular" size="13.0" />
               </font>
            </Label>
         </children>
      </Pane>

      <!-- Campo de correo -->
      <TextField fx:id="txtCorreo" layoutX="99.0" layoutY="285.0" prefHeight="40.0" prefWidth="310.0" promptText="Correo electrónico" style="-fx-prompt-text-fill: #A0A0A0;">
         <font>
            <Font name="Poppins Regular" size="14.0" />
         </font>
      </TextField>

      <!-- Botón Enviar -->
      <Button fx:id="btnEnviar" layoutX="191.0" layoutY="350.0" mnemonicParsing="false" onAction="#enviarEnlaceRecuperacion" prefHeight="42.0" prefWidth="127.0" style="-fx-background-color: #23AAFA; -fx-text-fill: #FFFFFF; -fx-border-radius: 8; -fx-background-radius: 8;" text="Enviar enlace">
         <font>
            <Font name="Poppins SemiBold" size="14.0" />
         </font>
      </Button>

      <!-- Enlace: Volver al login -->
      <Label layoutX="99.0" layoutY="415.0" prefHeight="20.0" prefWidth="188.0" text="¿Recordaste tu contraseña?" textFill="#555555">
         <font>
            <Font name="Poppins Regular" size="13.0" />
         </font>
      </Label>
      <Label fx:id="lblVolverLogin" layoutX="296.0" layoutY="415.0" prefHeight="20.0" prefWidth="96.0" text="Iniciar sesión" textFill="#23AAFA" underline="true">
         <font>
            <Font name="Poppins Medium" size="13.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
