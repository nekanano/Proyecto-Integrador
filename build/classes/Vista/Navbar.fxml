<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<HBox fx:controller="Controlador.NavbarController" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="80.0" prefWidth="477.0" spacing="60.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
   <children>
        <Button fx:id="btnHome" mnemonicParsing="false" style="-fx-background-color: transparent;">
            <graphic>
                <ImageView fx:id="imgHome" fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../Iconos/hogar.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>
        <Button fx:id="btnAgendas" mnemonicParsing="false" style="-fx-background-color: transparent;">
            <graphic>
                <ImageView fx:id="imgAgendas" fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../Iconos/calendario.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>
        <Button fx:id="btnpreguntas" mnemonicParsing="false" style="-fx-background-color: transparent;">
            <graphic>
                <ImageView fx:id="imgComentario" fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../Iconos/comentario-pregunta.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>        
        <Button fx:id="btnPerfil" mnemonicParsing="false" style="-fx-background-color: transparent;">
            <graphic>
                <ImageView fx:id="imgPerfil" fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../Iconos/usuario.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>
   </children>
</HBox>
